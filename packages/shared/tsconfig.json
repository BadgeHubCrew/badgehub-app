{
  "compilerOptions": {
    // Base Options recommended for all projects
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2023",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true, // Enable all strict type-checking options (Zod + oRPC contracts)
    "noUncheckedIndexedAccess": true,
    //    "erasableSyntaxOnly": true, // TODO enable this and refactor get rid of violations of this rule
    "noImplicitOverride": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "noEmit": true,
    "lib": ["es2023"],
    "paths": {
      "@shared/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.tstest.ts"]
}

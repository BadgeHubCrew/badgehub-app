          },
          "revision": {
            "description": "Revision of the project for this variant. If it is not present, then the revision of the project should be used.
Warning: if it is present, then badgehub clients on badges will not update the app unless the this revision number is increased.",
            "examples": undefined,
            "maximum": 9007199254740991,
            "minimum": 0,
            "title": undefined,
            "type": "integer",
          },
          "type": {
            "description": "the type of the application variant, eg 'standalone', 'badge_vms', 'appfs', 'micropython', 'circuitpython', ...",
            "examples": undefined,
            "title": undefined,
            "type": "string",
          },
        },
        "type": "object",
      },
      "Version": {
        "properties": {
          "app_metadata": {
            "$ref": "#/components/schemas/AppMetadataJSON",
          },
          "blur_hash": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileMetadata",
            },
            "type": "array",
          },
          "project_slug": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "published_at": {
            "anyOf": [
              {
                "description": undefined,
                "examples": [
                  "2024-08-10T14:48:00.000Z",
                ],
                "pattern": "^[\\s\\S]{0,}\\.-?\\d+Z$",
                "title": undefined,
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "revision": {
            "type": "number",
          },
        },
        "required": [
          "revision",
          "files",
          "app_metadata",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "apiTokenAuth": {
        "description": "Project-specific API token (for automation)",
